# Secure Payment Gateway — environment variables
# Copy to .env and adjust. Every key maps to config/config.yaml (prefix SPG_, "." -> "_").
# Values below match a local run against `docker compose up -d postgres redis`.

# ---- Required secrets -------------------------------------------------------
# JWT signing key, at least 32 characters.   Generate: openssl rand -base64 48
SPG_JWT_SECRET=
# AES-256-GCM key, exactly 64 hex characters. Generate: openssl rand -hex 32
SPG_AES_KEY=

# ---- Server ------------------------------------------------------------------
SPG_SERVER_HOST=0.0.0.0
SPG_SERVER_PORT=8080
# debug | release | test  (Swagger UI is disabled in release mode)
SPG_SERVER_MODE=debug

# ---- PostgreSQL --------------------------------------------------------------
SPG_DATABASE_HOST=localhost
# docker-compose publishes PostgreSQL on host port 5435
SPG_DATABASE_PORT=5435
SPG_DATABASE_USER=postgres
SPG_DATABASE_PASSWORD=postgres
SPG_DATABASE_DBNAME=payment_gateway
SPG_DATABASE_SSLMODE=disable
SPG_DATABASE_MAX_CONNS=20
SPG_DATABASE_MIN_CONNS=5
SPG_DATABASE_CONN_MAX_LIFETIME=30m

# ---- Redis -------------------------------------------------------------------
SPG_REDIS_HOST=localhost
SPG_REDIS_PORT=6379
SPG_REDIS_PASSWORD=
SPG_REDIS_DB=0

# ---- JWT ---------------------------------------------------------------------
SPG_JWT_EXPIRY=24h
SPG_JWT_ISSUER=secure-payment-gateway

# ---- Logging -----------------------------------------------------------------
# debug | info | warn | error
SPG_LOG_LEVEL=info
SPG_LOG_PRETTY=true

# ---- Security ----------------------------------------------------------------
# Accept signed requests when the Redis nonce store is down. Keep false in
# production: true disables replay protection during a Redis outage.
SPG_SECURITY_NONCE_FAIL_OPEN=false

# ---- Rate-limit overrides (requests/minute, 0 = built-in default) -----------
SPG_RATELIMIT_PAYMENTS=0
SPG_RATELIMIT_PAYMENTS_REFUND=0
